# Terraform local state / scratch files (remote S3 backend planned later)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Sensitive variables — never commit
*.tfvars
*.tfvars.json

# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it.